# Claude API key — get one from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Google OAuth credentials — from Google Cloud Console (see README for steps)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth
NEXTAUTH_SECRET=      # generate with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000   # set to your Vercel URL in production
